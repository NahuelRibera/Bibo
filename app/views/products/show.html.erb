<%
  images = @product.product_images
  axes = @product.variant_axes
  default_variant = @product.default_variant
  variants_payload = axes[:variants].map { |v| v.merge(price_display: euro_price(v[:price_cents])) }
%>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <%= link_to "Home", root_path %>
  <span aria-hidden="true">/</span>
  <%= link_to @product.category.name, category_path(@product.category) %>
  <span aria-hidden="true">/</span>
  <span aria-current="page"><%= @product.name %></span>
</nav>

<div class="product-detail">
  <div class="product-gallery" data-controller="gallery">
    <div class="gallery__thumbs" role="tablist" aria-label="Product images">
      <% images.each_with_index do |image, i| %>
        <button type="button"
                class="gallery__thumb <%= "is-active" if i.zero? %>"
                data-gallery-target="thumb"
                data-action="click->gallery#show"
                data-full-src="<%= image_path(image.image_path) %>"
                data-alt="<%= image.alt_text %>"
                aria-label="Show image <%= i + 1 %> of <%= images.size %>">
          <%= image_tag image.image_path, alt: "" %>
        </button>
      <% end %>
    </div>

    <div class="gallery__main">
      <% if images.first %>
        <img data-gallery-target="main" src="<%= image_path(images.first.image_path) %>" alt="<%= images.first.alt_text %>">
      <% end %>
      <% if images.size > 1 %>
        <button type="button" class="icon-button icon-button--bordered gallery__nav gallery__nav--prev" data-gallery-target="prev" data-action="gallery#previous" aria-label="Previous image">
          <%= icon(:chevron_left) %>
        </button>
        <button type="button" class="icon-button icon-button--bordered gallery__nav gallery__nav--next" data-gallery-target="next" data-action="gallery#next" aria-label="Next image">
          <%= icon(:chevron_right) %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="product-info" data-controller="variant-selector" data-variant-selector-variants-value="<%= variants_payload.to_json %>">
    <p class="product-info__tagline eyebrow"><%= @product.category.name %></p>

    <div class="product-info__header">
      <h1><%= @product.name %></h1>
      <%= render "products/wishlist_button", product: @product %>
    </div>

    <p class="product-info__price" data-variant-selector-target="price">
      <%= euro_price(default_variant&.price_cents || @product.base_price_cents) %>
    </p>

    <p class="product-info__rating">
      <% if @product.reviews_count > 0 %>
        <%= star_rating(@product.average_rating) %>
        <%= number_with_precision(@product.average_rating, precision: 1) %>
        <span><%= pluralize(@product.reviews_count, "review") %></span>
      <% else %>
        No reviews yet
      <% end %>
    </p>

    <p><%= @product.short_description %></p>

    <%= form_with url: cart_items_path, method: :post do %>
      <%= hidden_field_tag :product_variant_id, default_variant&.id, data: { variant_selector_target: "variantId" } %>

      <%# Both groups always render, even when there's only one value, so the
          hidden radio's value always matches the real (possibly blank)
          shared axis value the JS controller expects — rather than an
          empty-string stand-in that would misfire if that shared value
          ever turned out to be a real, non-blank string. %>
      <fieldset class="option-group" <%= "hidden" unless axes[:show_sizes] %>>
        <legend>Size</legend>
        <div class="option-pills">
          <% axes[:sizes].each do |size| %>
            <label class="option-pill">
              <input type="radio" name="size_option" value="<%= size %>"
                     data-variant-selector-target="sizeOption"
                     data-action="change->variant-selector#update"
                     <%= "checked" if size == default_variant&.option_label %>>
              <span><%= size %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="option-group" <%= "hidden" unless axes[:show_colours] %>>
        <legend>Colour</legend>
        <div class="option-pills">
          <% axes[:colours].each do |colour| %>
            <label class="option-pill">
              <input type="radio" name="colour_option" value="<%= colour %>"
                     data-variant-selector-target="colourOption"
                     data-action="change->variant-selector#update"
                     <%= "checked" if colour == default_variant&.colour %>>
              <span><%= colour %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <p class="stock-note" data-variant-selector-target="stockNote"></p>

      <div class="purchase-row">
        <div class="quantity-stepper" data-controller="quantity">
          <button type="button" data-action="quantity#decrement" aria-label="Decrease quantity"><%= icon(:minus, size: 16) %></button>
          <label for="quantity" class="visually-hidden">Quantity</label>
          <input type="number" name="quantity" id="quantity" value="1" min="1"
                 data-quantity-target="input" data-variant-selector-target="quantity">
          <button type="button" data-action="quantity#increment" aria-label="Increase quantity"><%= icon(:plus, size: 16) %></button>
        </div>

        <%= button_tag "Add to cart", type: "submit", class: "button", data: { variant_selector_target: "submit" }, disabled: axes[:variants].empty? %>
      </div>
    <% end %>

    <ul class="purchase-benefits">
      <li><%= icon(:check, size: 16) %> Free shipping on orders over €40</li>
      <li><%= icon(:check, size: 16) %> Easy 30-day returns</li>
      <li><%= icon(:check, size: 16) %> Made to last</li>
    </ul>

    <div data-controller="tabs" class="product-tabs">
      <div class="tabs__list" role="tablist" aria-label="Product information">
        <button type="button" class="tabs__tab" id="tab-description" role="tab" aria-selected="true" aria-controls="panel-description" tabindex="0" data-tabs-target="tab" data-action="click->tabs#select keydown->tabs#navigate">Description</button>
        <button type="button" class="tabs__tab" id="tab-details" role="tab" aria-selected="false" aria-controls="panel-details" tabindex="-1" data-tabs-target="tab" data-action="click->tabs#select keydown->tabs#navigate">Details</button>
        <button type="button" class="tabs__tab" id="tab-shipping" role="tab" aria-selected="false" aria-controls="panel-shipping" tabindex="-1" data-tabs-target="tab" data-action="click->tabs#select keydown->tabs#navigate">Shipping & Returns</button>
        <button type="button" class="tabs__tab" id="tab-reviews" role="tab" aria-selected="false" aria-controls="panel-reviews" tabindex="-1" data-tabs-target="tab" data-action="click->tabs#select keydown->tabs#navigate">Reviews (<%= @product.reviews_count %>)</button>
      </div>

      <div id="panel-description" class="tabs__panel" role="tabpanel" aria-labelledby="tab-description" data-tabs-target="panel">
        <p><%= @product.description %></p>
      </div>

      <div id="panel-details" class="tabs__panel" role="tabpanel" aria-labelledby="tab-details" data-tabs-target="panel" hidden>
        <p><%= @product.details.presence || "No further details for this piece yet." %></p>
      </div>

      <div id="panel-shipping" class="tabs__panel" role="tabpanel" aria-labelledby="tab-shipping" data-tabs-target="panel" hidden>
        <p><%= @product.shipping_returns_text.presence || "Free shipping on orders over €40, otherwise a flat €4.99. Unused items can be returned within 30 days." %></p>
      </div>

      <div id="panel-reviews" class="tabs__panel" role="tabpanel" aria-labelledby="tab-reviews" data-tabs-target="panel" hidden>
        <% if @product.reviews.any? %>
          <div class="reviews-summary">
            <span class="reviews-summary__score"><%= number_with_precision(@product.average_rating, precision: 1) %></span>
            <div>
              <%= star_rating(@product.average_rating) %>
              <p class="stock-note"><%= pluralize(@product.reviews_count, "review") %></p>
            </div>
          </div>
          <%= render partial: "reviews/review", collection: @product.reviews.order(created_at: :desc), as: :review %>
        <% else %>
          <p class="empty-state">No reviews yet. Be the first to share your thoughts on this piece.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
