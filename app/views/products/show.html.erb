<%
  variants = @product.product_variants.select(&:active?).sort_by { |v| [v.option_label.to_s, v.colour.to_s] }
  default_variant = @product.default_variant
  images = @product.product_images
%>

<div class="product-detail">
  <div class="product-detail__gallery">
    <% if images.first %>
      <%= image_tag images.first.image_path, alt: images.first.alt_text %>
    <% end %>
    <% if images.size > 1 %>
      <div class="product-detail__thumbs">
        <% images.each do |image| %>
          <%= image_tag image.image_path, alt: image.alt_text %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="product-detail__info">
    <p class="product-card__category"><%= @product.category.name %></p>
    <h1><%= @product.name %></h1>

    <p class="product-detail__price" data-variant-selector-target="price">
      <%= euro_price(default_variant&.price_cents || @product.base_price_cents) %>
    </p>

    <p class="product-detail__rating">
      <% if @product.reviews_count > 0 %>
        ★ <%= number_with_precision(@product.average_rating, precision: 1) %> (<%= pluralize(@product.reviews_count, "review") %>)
      <% else %>
        No reviews yet
      <% end %>
    </p>

    <p><%= @product.short_description %></p>

    <%= form_with url: cart_items_path, method: :post, data: { controller: "variant-selector" } do %>
      <div class="form-field" style="<%= "display: none;" if variants.size <= 1 %>">
        <label for="product_variant_id">
          <%= variants.any? { |v| v.option_label.present? } ? "Size" : "Option" %>
        </label>
        <select name="product_variant_id" id="product_variant_id" data-variant-selector-target="select" data-action="change->variant-selector#update">
          <% variants.each do |variant| %>
            <option value="<%= variant.id %>"
                    data-price="<%= euro_price(variant.price_cents) %>"
                    data-stock="<%= variant.stock %>"
                    data-purchasable="<%= variant.purchasable? %>"
                    <%= "selected" if variant == default_variant %>>
              <%= variant.label %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="form-field">
        <label for="quantity">Quantity</label>
        <input type="number" name="quantity" id="quantity" value="1" min="1" data-variant-selector-target="quantity">
      </div>

      <p class="stock-note" data-variant-selector-target="stockNote"></p>

      <button type="submit" class="button" data-variant-selector-target="submit" <%= "disabled" if variants.empty? %>>
        Add to cart
      </button>
    <% end %>

    <div class="product-detail__section">
      <h3>Description</h3>
      <p><%= @product.description %></p>
    </div>

    <% if @product.details.present? %>
      <div class="product-detail__section">
        <h3>Details</h3>
        <p><%= @product.details %></p>
      </div>
    <% end %>

    <% if @product.shipping_returns_text.present? %>
      <div class="product-detail__section">
        <h3>Shipping &amp; returns</h3>
        <p><%= @product.shipping_returns_text %></p>
      </div>
    <% end %>
  </div>
</div>

<section class="section">
  <h2>Reviews (<%= @product.reviews_count %>)</h2>

  <% if @product.reviews.any? %>
    <%= render partial: "reviews/review", collection: @product.reviews.order(created_at: :desc), as: :review %>
  <% else %>
    <p class="empty-state">No reviews yet.</p>
  <% end %>
</section>
