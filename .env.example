# Copy this file to .env and fill in your own Stripe TEST MODE keys from
# https://dashboard.stripe.com/test/apikeys
#
# .env is gitignored and loaded automatically in development/test via the
# dotenv-rails gem. It is never read in production.
#
# Without these, Bibo still boots and the whole storefront (catalogue, cart,
# wishlist) still works - only the checkout button is disabled, with a
# message explaining why.

STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Only needed if you're testing the webhook endpoint locally, e.g. with the
# Stripe CLI (`stripe listen --forward-to localhost:3000/webhooks/stripe`),
# which prints a whsec_... secret for this to use.
STRIPE_WEBHOOK_SECRET=whsec_...
